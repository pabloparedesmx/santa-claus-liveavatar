# ==============================================
# SANTA CLAUS LIVE AVATAR - Environment Variables
# ==============================================

# --------------------------------------------
# HeyGen API Configuration
# --------------------------------------------
# Get your HeyGen API key from: https://app.heygen.com/settings
VITE_HEYGEN_API_KEY=your_heygen_api_key_here

# Santa Avatar Configuration
# Find these IDs in your HeyGen dashboard after creating your avatar
VITE_HEYGEN_SANTA_AVATAR_ID=your_santa_avatar_id_here
VITE_HEYGEN_SANTA_VOICE_ID=your_santa_voice_id_here

# Optional: Context ID for personalized conversations
# Leave empty if not using knowledge base
VITE_HEYGEN_SANTA_CONTEXT_ID=

# --------------------------------------------
# Stripe Payment Configuration
# --------------------------------------------
# Get your Stripe keys from: https://dashboard.stripe.com/apikeys

# SECRET KEY - NEVER commit this or share publicly!
# Use TEST keys (sk_test_...) for development
# Use LIVE keys (sk_live_...) for production
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Webhook Secret - Get this after creating a webhook endpoint
# Dashboard -> Developers -> Webhooks -> Add endpoint
# Endpoint URL: https://your-domain.com/api/webhook/stripe
# Events to listen: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# --------------------------------------------
# Frontend Configuration
# --------------------------------------------
# URL where your frontend is hosted
# Development: http://localhost:5176
# Production: https://your-domain.com
FRONTEND_URL=http://localhost:5176

# --------------------------------------------
# Supabase Configuration (Coming Soon)
# --------------------------------------------
# Get these from: https://app.supabase.com/project/_/settings/api
# SUPABASE_URL=your_supabase_project_url_here
# SUPABASE_ANON_KEY=your_supabase_anon_key_here
# SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# --------------------------------------------
# Zapier Webhook (Coming Soon)
# --------------------------------------------
# Webhook URL for letter generation
# ZAPIER_WEBHOOK_URL=your_zapier_webhook_url_here

# ==============================================
# SETUP INSTRUCTIONS
# ==============================================

# 1. Copy this file to .env:
#    cp .env.example .env

# 2. Fill in your API keys above

# 3. For Stripe webhooks in development, use Stripe CLI:
#    stripe listen --forward-to localhost:3001/api/webhook/stripe
#    This will give you a webhook secret starting with whsec_

# 4. NEVER commit your .env file to git!
#    It's already in .gitignore

# ==============================================
# TESTING WITH STRIPE
# ==============================================

# Use these test card numbers:
# - Success: 4242 4242 4242 4242
# - Requires authentication: 4000 0025 0000 3155
# - Decline: 4000 0000 0000 9995

# Any future expiry date (e.g., 12/34)
# Any 3-digit CVC
# Any postal code

# ==============================================
# PRODUCTION CHECKLIST
# ==============================================

# Before deploying to production:
# [ ] Replace all test keys with live keys
# [ ] Set FRONTEND_URL to your production domain
# [ ] Create production webhook in Stripe dashboard
# [ ] Update STRIPE_WEBHOOK_SECRET with production webhook secret
# [ ] Ensure .env is NOT in your git repository
# [ ] Set up environment variables in your hosting platform
