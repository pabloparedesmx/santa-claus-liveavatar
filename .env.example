# HeyGen LiveAvatar API Configuration
VITE_HEYGEN_API_KEY=your_heygen_api_key_here
VITE_HEYGEN_SANTA_AVATAR_ID=your_santa_avatar_id_here
VITE_HEYGEN_SANTA_VOICE_ID=your_santa_voice_id_here

# Backend API Endpoint (for token generation)
# This should be your Supabase Edge Function URL or custom backend
VITE_HEYGEN_API_ENDPOINT=http://localhost:3000/api/generate-heygen-token

# Stripe Configuration
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Zapier Webhook (for letter generation)
VITE_ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/your_webhook_id/

# Application Settings
VITE_APP_URL=http://localhost:5173
VITE_SESSION_DURATION_SECONDS=300
